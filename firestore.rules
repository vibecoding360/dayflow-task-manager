rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == "owner";
    }

    // The personal workspace ID is the owner's Firebase UID. This lets that
    // owner safely resume first-time provisioning if membership creation was
    // interrupted, without opening another user's workspace.
    function isPersonalWorkspaceOwner(workspaceId) {
      return signedIn()
        && request.auth.uid == workspaceId
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // User profile and existing personal task collection.
    match /users/{userId} {
      allow read, create, update: if ownsUser(userId);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, create, update, delete: if ownsUser(userId);
      }
    }

    // Multi-tenant foundation: every workspace has an owner and explicit members.
    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && request.auth.uid == workspaceId
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if isWorkspaceMember(workspaceId)
        || (signedIn() && request.auth.uid == workspaceId);
      allow update: if isPersonalWorkspaceOwner(workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isWorkspaceOwner(workspaceId);

      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update: if (
          signedIn()
          && request.auth.uid == memberId
          && isPersonalWorkspaceOwner(workspaceId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == "owner"
        ) || isWorkspaceOwner(workspaceId);
        allow delete: if isWorkspaceOwner(workspaceId);
      }

      match /tasks/{taskId} {
        allow read, create, update, delete: if isWorkspaceMember(workspaceId);
      }

      match /projects/{projectId} {
        allow read, create, update, delete: if isWorkspaceMember(workspaceId);
      }

      match /goals/{goalId} {
        allow read, create, update, delete: if isWorkspaceMember(workspaceId);
      }
    }

    // Billing records are server-managed; clients cannot write subscription state.
    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }
  }
}
